# --- Paystack ---
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Techlink GH ---
TECHLINK_API_BASE_URL=https://api.techlinkgh.com/api/v1
TECHLINK_API_KEY=your_techlink_api_key_here

# --- Database (Supabase) ---
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
SUPABASE_SERVICE_ROLE_KEY=

# --- Admin ---
ADMIN_PASSWORD=choose-a-long-unique-password
ADMIN_SESSION_SECRET=replace_with_32_plus_random_characters
CUSTOMER_SESSION_SECRET=replace_with_a_different_32_plus_random_characters
# Optional role-based admin accounts. Roles are hierarchical: viewer < operator < admin.
#   viewer   read-only (overview, orders, feedback, reviews)
#   operator + re-check / process / retry orders, reconciliation, wallet, audit log, feedback, reviews
#   admin    + manually marking an order delivered, and the full customer orders CSV export
# A user with a missing or misspelt "role" is a VIEWER (never an admin). Add "disabled":true to
# lock someone out at once. Changes apply to people who are already signed in on their next request.
# Example: [{"username":"ops","role":"operator","passwordHash":"salt$64hex"}]
ADMIN_USERS_JSON=[]

# --- AFA sensitive-data protection ---
# Used for AES-256-GCM encryption of new AFA registration details at rest.
# Use a separate 32+ character random secret. Existing plaintext historical rows
# are handled by the v1.3.5 migration and should be reviewed before production.
AFA_ENCRYPTION_KEY=replace_with_a_separate_32_plus_random_characters

# --- Fulfillment worker ---
CRON_SECRET=replace_with_32_plus_random_characters
FULFILLMENT_BATCH_SIZE=3
MAX_FULFILLMENT_ATTEMPTS=5

TECHLINK_LOW_BALANCE_THRESHOLD=200
NEXT_PUBLIC_TECHLINK_LOW_BALANCE_THRESHOLD=200
TECHLINK_LOW_BALANCE_ALERT_COOLDOWN_HOURS=6
TECHLINK_TIMEOUT_MS=20000

# --- AI support (optional) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_MS=15000
GEMINI_MAX_RETRIES=3

# --- Public site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
FULFILLMENT_STALE_MINUTES=30

# --- Notifications ---
RESEND_API_KEY=
NOTIFICATION_FROM_EMAIL="PjDigitalServices <alerts@updates.pjdigitalservices.online>"
SUPPORT_REPLY_TO_EMAIL=support@pjdigitalservices.online
ADMIN_ALERT_EMAIL=
URGENT_REVIEW_MINUTES=30
BREVO_API_KEY=
BREVO_SMS_SENDER=PjDigital
ADMIN_SMS_TO=233XXXXXXXXX

# --- Pricing ---
PAYSTACK_FEE_RATE=0.0195
PAYSTACK_VERIFY_TIMEOUT_MS=10000
# Applies to every product except Airtime, bulk Airtime and Quick Data Top-up (0% by policy).
# If you set this in Vercel it OVERRIDES the code default, so keep it at 2 or delete it.
DEFAULT_BUSINESS_MARGIN_PERCENT=1
# Fixed-only rules are true overrides, e.g. {"water":{"fixed":1}} means GHS 1
# fixed business markup and does NOT also add the default 2%.
SERVICE_MARKUP_RULES_JSON={}
MAX_BULK_ROWS=100
MAX_BULK_TOTAL_GHS=5000
MAX_BULK_LINE_GHS=500
MAX_ORDER_PRODUCT_GHS=10000

# --- Support ---
QUEUED_ALERT_MINUTES=180
BULK_AUTO_CONFIRM=false
# WhatsApp fallback shown after unresolved manual review exceeds 6 hours.
NEXT_PUBLIC_SUPPORT_WHATSAPP_URL=

# --- Two-factor sign-in (TOTP: Google Authenticator, Microsoft Authenticator, Authy, 1Password) ---
# Create a secret with:  npm run admin:user -- --shared-totp      (single shared login)
#                  or:   npm run admin:user -- --username kofi --role operator   (named account; prints a "totpSecret")
# With named accounts the secret lives in ADMIN_USERS_JSON ("totpSecret"). With the single shared
# ADMIN_PASSWORD it is ADMIN_TOTP_SECRET. Turning it on also ends any session opened without it.
ADMIN_TOTP_SECRET=
# true = nobody can sign in without a code. An account with no secret is refused outright.
ADMIN_REQUIRE_2FA=

# --- Background worker ---
# How many still-"unpaid" checkouts each worker run re-checks with Paystack (finds customers who
# paid but whose payment was never recorded). The scheduled run uses this; "Run worker now" uses 25.
SWEEP_BATCH_SIZE=8
# Techlink's fee added to every airtime purchase when it debits our wallet. Used only to record
# cost accurately if the live fee lookup is unavailable (documented as 2%).
AIRTIME_PROVIDER_FEE_RATE=0.02

# ---------------------------------------------------------------------------
# Delivery safety (v1.4.0). These protect your Techlink wallet.
# ---------------------------------------------------------------------------
# PAYSTACK_SECRET_KEY must be your LIVE key (sk_live_...) on the production site.
# In production the app refuses any payment Paystack labels "test", and refuses
# everything if the key itself is a test key. Only set the next line on a private
# staging copy that is NOT connected to your real Techlink wallet:
# ALLOW_PAYSTACK_TEST_PAYMENTS=true
#
# Starting delivery mode. The admin dashboard switch (stored in the database)
# overrides this. "automatic" = fresh live payments are delivered at once;
# "manual" = every paid order waits for an admin to approve it.
DELIVERY_MODE=automatic
# A checkout older than this many minutes is never delivered automatically, even
# when Paystack confirms it. It waits for an admin to approve it.
AUTO_DELIVERY_MAX_AGE_MINUTES=45

# ---------------------------------------------------------------------------
# v1.4.3: who may spend wallet money, alert volume, second trigger
# ---------------------------------------------------------------------------
# Approve & deliver, Send now and Authorise retry spend Techlink wallet money.
# "admin" (default) = only an admin account; "operator" = operators may too.
# WALLET_SPEND_ROLE=admin
#
# Paid orders the app deliberately holds are summarised in ONE digest email. When one has
# waited this many hours, ONE urgent digest (email + one SMS) is sent instead.
# HELD_URGENT_HOURS=4
#
# TECHLINK_API_KEY must be your LIVE key (tlg_live_...) on the production site. A tlg_test_
# key is refused for real orders (they wait, nothing is sent) and the dashboard shows a red
# banner. ALLOW_PAYSTACK_TEST_PAYMENTS=true also allows a Techlink test key on a staging copy.
#
# vercel.json now runs /api/jobs/fulfill once a day as a safety net (Vercel Cron sends
# Authorization: Bearer <CRON_SECRET>, so CRON_SECRET must be set in Vercel). The Hobby plan
# only allows daily schedules; on Pro you can change it to "*/5 * * * *".

