# --- Paystack ---
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Techlink GH ---
TECHLINK_API_BASE_URL=https://api.techlinkgh.com/api/v1
TECHLINK_API_KEY=your_techlink_api_key_here

# --- Database (Supabase) ---
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Supabase secret key (preferred). Legacy service_role is supported for existing projects.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
SUPABASE_SERVICE_ROLE_KEY=

# --- Admin ---
ADMIN_PASSWORD=choose-a-long-unique-password
# At least 32 random characters. Used to sign the HttpOnly admin session cookie.
ADMIN_SESSION_SECRET=replace_with_32_plus_random_characters
# A SEPARATE random string of 32+ characters — never reuse ADMIN_SESSION_SECRET
# here. Signs customer login session cookies (real accounts with passwords).
CUSTOMER_SESSION_SECRET=replace_with_a_different_32_plus_random_characters

# --- Fulfillment worker ---
# Secret for your scheduler/cron to call /api/jobs/fulfill.
CRON_SECRET=replace_with_32_plus_random_characters
FULFILLMENT_BATCH_SIZE=10
MAX_FULFILLMENT_ATTEMPTS=5

# Proactive Techlink wallet balance alert (email + SMS via the same
# ADMIN_ALERT_EMAIL / ADMIN_SMS_TO config below), checked on every
# /api/jobs/fulfill run (every 5 minutes). This is what catches "wallet ran
# dry" BEFORE customers get charged with nothing delivered, instead of only
# finding out after an order fails and exhausts its retries. Set the
# NEXT_PUBLIC_ version to the SAME number — it drives the admin dashboard's
# low-balance banner, which is client-side and needs the public prefix.
TECHLINK_LOW_BALANCE_THRESHOLD=200
NEXT_PUBLIC_TECHLINK_LOW_BALANCE_THRESHOLD=200
# Minimum hours between repeat low-balance alerts while the balance stays
# under the threshold, so a slow top-up doesn't cause an alert every 5
# minutes. Resets automatically once the balance recovers above threshold.
TECHLINK_LOW_BALANCE_ALERT_COOLDOWN_HOURS=6
# Abort a Techlink call after this many ms. A timeout is treated as an AMBIGUOUS
# outcome (order held for manual review, never auto-retried).
TECHLINK_TIMEOUT_MS=20000

# --- AI support (optional) ---
# Without this key, the chatbot automatically falls back to the built-in FAQ assistant.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Public site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

FULFILLMENT_STALE_MINUTES=10

# --- Notifications (optional but recommended for production) ---
RESEND_API_KEY=
NOTIFICATION_FROM_EMAIL="PjDigitalServices <alerts@updates.pjdigitalservices.online>"
# Verify updates.pjdigitalservices.online (a SUBDOMAIN, not the root domain)
# in Resend — this keeps Resend's required MX/SPF records completely
# separate from the root domain's Namecheap Private Email MX/SPF records,
# so setting this up can never break support@pjdigitalservices.online
# receiving mail. Customers replying to an automated email land in the real
# inbox because of SUPPORT_REPLY_TO_EMAIL below, not because of this address.
SUPPORT_REPLY_TO_EMAIL=support@pjdigitalservices.online
ADMIN_ALERT_EMAIL=
URGENT_REVIEW_MINUTES=30

# Optional urgent-escalation SMS via Brevo (fires only when an order sits in
# manual review past URGENT_REVIEW_MINUTES). The email leg of the escalation
# reuses ADMIN_ALERT_EMAIL / RESEND_API_KEY above — no separate config needed.
BREVO_API_KEY=
# Alphanumeric sender ID shown as the SMS "from"; max 11 characters, letters/digits only.
BREVO_SMS_SENDER=PjDigital
# E.164-style, no spaces, e.g. 233240000000 (leading + is stripped automatically).
ADMIN_SMS_TO=233XXXXXXXXX

# Pricing controls
# Paystack fee rate: 1.95% of the gross transaction amount.
PAYSTACK_FEE_RATE=0.0195
# Default PjDigitalServices business margin applied to provider cost.
DEFAULT_BUSINESS_MARGIN_PERCENT=1
# Optional service/network overrides. JSON keys can be orderType or orderType:network.
# Example: {"data:mtn":{"percent":1.5},"water":{"fixed":1}}
SERVICE_MARKUP_RULES_JSON={}
MAX_BULK_ROWS=100
MAX_BULK_TOTAL_GHS=5000
MAX_BULK_LINE_GHS=500
MAX_ORDER_PRODUCT_GHS=10000

# Vercel cron authenticates the fulfillment worker with this secret. Use a 32+ character random value.
CRON_SECRET=
# Optional stronger admin mode. When set, this replaces the shared ADMIN_PASSWORD login.
# passwordHash format: salt$64-hex-scrypt-hash. Keep this JSON compact for environment variables.
ADMIN_USERS_JSON=[]

# --- v1.3.1 ---
# Alert the admin (once per order) when a queued order has waited this many
# minutes with no confirmed delivery. Bulk orders can't auto-resolve, so this
# is how you find out they need a manual check.
QUEUED_ALERT_MINUTES=180
# Bulk data/airtime: the per-row result shape is unknown, so by default a bulk
# batch waits in "queued" until you confirm delivery. Set to "true" to trust a
# 2xx response and mark it delivered immediately (the pre-v1.3.1 behaviour).
BULK_AUTO_CONFIRM=false


# Customer support WhatsApp link shown after unresolved manual review exceeds 3 hours
NEXT_PUBLIC_SUPPORT_WHATSAPP_URL=
